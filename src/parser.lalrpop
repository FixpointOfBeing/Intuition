use crate::syntax::*;

grammar;

match {
    r"\s*" => { },
    r"//[^\n\r]*" => { },
    r"/\*([^*]|\*+[^*/])*\*/" => { },
    "->",
    "==",
    "!=",
    "<=",
    ">=",
    "&&",
    "||"
} else {
    _
}

pub Program: Box<Program> = {
    <defs:(Def)*> <main:Expr> => {
        let defs = defs.into_iter().map(|def| *def).collect::<Vec<Def>>();
        let main = *main;
        Box::new(Program { defs, main })
    }
}

pub Def: Box<Def> = {
    "let" <v:Ident> <opty:(":" Type)?> "=" <e:Expr> ";" => {
        match opty {
            None => Box::new(Def::ValDef(v, None, *e)),
            Some((_, ty)) => Box::new(Def::ValDef(v, Some(*ty), *e))
        }
    },

    "let" <name:Ident> <params:("(" Ident ":" Type ")")+> <opty:(":" Type)?> "=" <e:Expr> ";" => {
        let mut params1: Vec<(Ident, Type)> = vec![];
        let mut lambda_ty: Vec<Type> = vec![];
        for (_lp, id, _colon, ty, _rp) in params {
            params1.push((id.to_string(), (*ty).clone()));
            lambda_ty.push(*ty);
        }

        let rt_ty = match opty {
            None => None,
            Some((_, rt_ty)) => Some(*rt_ty),
        };

        Box::new(Def::FunDef(name, params1, rt_ty, *e))
    }
}

pub Expr: Box<Expr> = {
    Term,
};

Term: Box<Expr> = {
    "fun" <params:("(" Ident ":" Type ")")+> <opty:(":" Type)?> "=>" <e:Expr> => {
        let mut params1: Vec<(Ident, Type)> = vec![];
        for (_lp, id, _colon, ty, _rp) in params {
            params1.push((id.to_string(), *ty));
        }
        match opty {
            None => Box::new(Expr::Lambda(params1, None, e)),
            Some((_, rt_ty)) => Box::new(Expr::Lambda(params1, Some(*rt_ty), e))
        }
    },

    "let" <v:Ident> <opty:(":" Type)?> "=" <e1:Expr> "in" <e2:Expr> => {
        match opty {
            None => Box::new(Expr::Let(v, None, e1, e2)),
            Some((_, ty)) => Box::new(Expr::Let(v, Some(*ty), e1, e2))
        }
    },

    "let" <v:Ident> <params:("(" Ident ":" Type ")")+> <opty:(":" Type)?> "=" <e1:Expr> "in" <e2:Expr> => {
        let mut params1: Vec<(Ident, Type)> = vec![];
        let mut lambda_ty: Vec<Type> = vec![];
        for (_lp, id, _colon, ty, _rp) in params {
            params1.push((id.to_string(), (*ty).clone()));
            lambda_ty.push(*ty);
        }
        match opty {
            None => {
                let lambda = Box::new(Expr::Lambda(params1, None, e1));
                Box::new(Expr::Let(v, None, lambda, e2))
            }
            Some((_, rt_ty)) => {
                let lambda = Box::new(Expr::Lambda(params1, Some((*rt_ty).clone()), e1));
                let arrow = lambda_ty
                    .into_iter()
                    .rev()
                    .fold(*rt_ty, |acc, p| Type::Arrow(Box::new(p), Box::new(acc)));
                Box::new(Expr::Let(v, Some(arrow), lambda, e2))
            }
        }
    },

    "let" "rec" <fname:Ident> <params:("(" Ident ":" Type ")")+> ":" <fret_ty:Type> "=" <fbody:Expr> "in" <body:Expr> => {
        let mut fparams: Vec<(Ident, Type)> = vec![];
        for (_lp, id, _colon, ty, _rp) in params {
            fparams.push((id.to_string(), *ty));
        }
        Box::new(Expr::LetRec(fname, fparams, *fret_ty, fbody, body))
    },

    "if" <e1:Expr> "then" <e2:Expr> "else" <e3:Expr> => Box::new(Expr::If(e1, e2, e3)),
    OrExpr,
};

// Binary operators with precedence (lowest to highest)
OrExpr: Box<Expr> = {
    <e1:OrExpr> "||" <e2:AndExpr> => Box::new(Expr::BinOp(BinOp::Or, e1, e2)),
    AndExpr,
};

AndExpr: Box<Expr> = {
    <e1:AndExpr> "&&" <e2:EqExpr> => Box::new(Expr::BinOp(BinOp::And, e1, e2)),
    EqExpr,
};

EqExpr: Box<Expr> = {
    <e1:EqExpr> "==" <e2:CmpExpr> => Box::new(Expr::BinOp(BinOp::Eq, e1, e2)),
    <e1:EqExpr> "!=" <e2:CmpExpr> => Box::new(Expr::BinOp(BinOp::Neq, e1, e2)),
    CmpExpr,
};

CmpExpr: Box<Expr> = {
    <e1:CmpExpr> "<" <e2:AddExpr> => Box::new(Expr::BinOp(BinOp::Lt, e1, e2)),
    <e1:CmpExpr> "<=" <e2:AddExpr> => Box::new(Expr::BinOp(BinOp::Leq, e1, e2)),
    <e1:CmpExpr> ">" <e2:AddExpr> => Box::new(Expr::BinOp(BinOp::Gt, e1, e2)),
    <e1:CmpExpr> ">=" <e2:AddExpr> => Box::new(Expr::BinOp(BinOp::Geq, e1, e2)),
    AddExpr,
};

AddExpr: Box<Expr> = {
    <e1:AddExpr> "+" <e2:MulExpr> => Box::new(Expr::BinOp(BinOp::Add, e1, e2)),
    <e1:AddExpr> "-" <e2:MulExpr> => Box::new(Expr::BinOp(BinOp::Sub, e1, e2)),
    MulExpr,
};

MulExpr: Box<Expr> = {
    <e1:MulExpr> "*" <e2:UnaryOp> => Box::new(Expr::BinOp(BinOp::Mul, e1, e2)),
    <e1:MulExpr> "/" <e2:UnaryOp> => Box::new(Expr::BinOp(BinOp::Div, e1, e2)),
    UnaryOp,
};

UnaryOp: Box<Expr> = {
    "-" <e:App> => Box::new(Expr::UnaryOp(UnaryOp::Neg, e)),
    "!" <e:App> => Box::new(Expr::UnaryOp(UnaryOp::Not, e)),
    App,
};

App: Box<Expr> = {
    <f:Projection> <args:Projection+> => {
        let mut args_vec = Vec::new();
        for arg in args {
            args_vec.push(*arg);
        }
        
        if let Expr::Var(ref v) = *f {
            match v.as_str() {
                "print_int" => {
                    if args_vec.len() != 1 {
                        panic!("print_int expects exactly one argument")
                    } else {
                      Box::new(Expr::PrimIO(PrimIO::PrintInt, Some(Box::new(args_vec.remove(0)))))
                    }
                },
                "print_float" => {
                    if args_vec.len() != 1 {
                        panic!("print_float expects exactly one argument")
                    } else {
                      Box::new(Expr::PrimIO(PrimIO::PrintFloat, Some(Box::new(args_vec.remove(0)))))
                    }
                },
                "print_bool" => {
                    if args_vec.len() != 1 {
                        panic!("print_bool expects exactly one argument")
                    } else {
                      Box::new(Expr::PrimIO(PrimIO::PrintBool, Some(Box::new(args_vec.remove(0)))))
                    }
                },
                "read_int" => {
                    // read_int takes an unit as argument
                    if args_vec.len() != 1 && !matches!(args_vec[0], Expr::Unit) {
                        panic!("read_int expects exactly one argument (unit)")
                    } else {
                      Box::new(Expr::PrimIO(PrimIO::ReadInt, None))
                    }
                },
                "read_float" => {
                    // read_float takes an unit as argument
                    if args_vec.len() != 1 && !matches!(args_vec[0], Expr::Unit) {
                        panic!("read_float expects exactly one argument (unit)")
                    } else {
                      Box::new(Expr::PrimIO(PrimIO::ReadFloat, None))
                    }
                },
                _ => Box::new(Expr::App(f, args_vec)),
                
            }
        } else {
           Box::new(Expr::App(f, args_vec))
        }
    },

    Projection,
};

Projection: Box<Expr> = {
    <e:Projection> "." <n:r"[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?"> => {
        if n.contains('.') || n.contains('e') || n.contains('E') {
            panic!("tuple projection index must be a non-negative integer, got: {}", n);
        }
        Box::new(Expr::TupleProjection(e, n.parse::<usize>().unwrap()))
    },
    Factor,
};

Factor: Box<Expr> = {
    <v:Ident> => Box::new(Expr::Var(v)),

    <n:r"[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?"> => {
        if n.contains('.') || n.contains('e') || n.contains('E') {
            Box::new(Expr::Float(n.parse().unwrap()))
        } else {
            Box::new(Expr::Int(n.parse().unwrap()))
        }
    },

    "true" => Box::new(Expr::Bool(true)),
    "false" => Box::new(Expr::Bool(false)),

    // tuple, at least 2 elements
    "(" <e1:Expr> "," <e2:Expr> <rest:("," <Expr>)*> ")" => {
        let mut elems = vec![*e1, *e2];
        for e in rest {
            elems.push(*e);
        }
        Box::new(Expr::Tuple(elems))
    },

    // annotation
    "(" <e:Expr> ":" <t:Type> ")" => Box::new(Expr::Ann(e, (*t).clone())),

    // parenthesized expression
    "(" <e:Expr> ")" => e,

    // unit
    "(" ")" => Box::new(Expr::Unit)
};

// Types
pub Type: Box<Type> = {
    ArrowType,
};

ArrowType: Box<Type> = {
    <t1:AtomType> "->" <t2:ArrowType> => Box::new(Type::Arrow(t1, t2)),
    AtomType,
};

AtomType: Box<Type> = {
    "Int" => Box::new(Type::Int),
    "Float" => Box::new(Type::Float),
    "Bool" => Box::new(Type::Bool),
    "Unit" => Box::new(Type::Unit),
    <v:Ident> => Box::new(Type::Var(v)),

    // tuple type, at least 2 elements
    "(" <t1:Type> "," <t2:Type> <rest:("," <Type>)*> ")" => {
        let mut elems = vec![*t1, *t2];
        for t in rest {
            elems.push(*t);
        }
        Box::new(Type::Tuple(elems))
    },

    // parenthesized type
    "(" <t:Type> ")" => t,
};

Ident: String = <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string();
